# Path (homepage) the dashboard is served from.
# Root domain:            VITE_BASE=/
# Subfolder:              VITE_BASE=/dashboard/
# GitHub Pages:           VITE_BASE=/ParkingDashboard/
# Relative (any folder):  VITE_BASE=./
VITE_BASE=/dashboard/

# ParkingDashboardAPI for THIS site. One API deployment serves one site and one
# database, so pointing this at another site's API switches the whole dashboard.
VITE_API_BASE=https://localhost:7164/api
# https://pksmetro.sproperty.co.th/dashboardapi/api

# Member request approval: the /member-requests endpoints are not on the API
# yet. 1 = serve sample requests from localStorage, 0 = call the API.
VITE_MEMBER_APPROVAL_MOCK=1
